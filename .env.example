# Copy this file to .env and fill in real values. Never commit the real .env file.

GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# Phase 4 (optional) — swap the planner backend from the hosted Gemini API to
# a cheaper locally-hosted fine-tuned model for routine steps. Leave as
# "hosted" unless you have a local model server running; safety behavior
# (risk classification, confirmation gate) is unaffected either way.
PLANNER_BACKEND=hosted
LOCAL_PLANNER_ENDPOINT=

DEFAULT_CHROME_PROFILE=Default
# PROFILES_DIR must be the actual Chrome "User Data" ROOT folder — e.g.
# C:\Users\<you>\AppData\Local\Google\Chrome\User Data — NOT a
# Pixel-only/profile-specific folder. DEFAULT_CHROME_PROFILE must be the real
# on-disk profile folder name (e.g. "Profile 3", "Default"), found via
# chrome://version -> "Profile Path" while that profile is active in Chrome —
# NOT the friendly display name shown in Chrome's profile picker (those are
# separate labels; "Yash" the display name might live in "Profile 3" on
# disk). Fully close Chrome before running Pixel — a real running Chrome on
# the same profile blocks Playwright from launching against it.
PROFILES_DIR=C:\Users\<you>\AppData\Local\Google\Chrome\User Data

MAX_STEPS_PER_TASK=40

# Optional — approves External-risk steps with NO confirmation prompt shown at all. Added because
# approving in a terminal steals OS focus from the actual target app (browser/Notepad), which can
# then go to the background and cause the next step to act on the wrong window. Does NOT affect
# Destructive-risk steps — those always still require the interactive confirm phrase, no exceptions.
# Defaults to false; only enable this on a machine you trust to run unattended.
AUTO_APPROVE_EXTERNAL=false

# Optional — tunes how the planner handles Gemini 429 rate-limit errors. Free-tier keys are capped
# at a few requests/minute, and the default retry can compound into several minutes of wait across
# a multi-step task. Set RATE_LIMIT_MAX_ATTEMPTS=1 to disable the retry entirely and see rate-limit
# errors immediately instead of waiting. RATE_LIMIT_MAX_BACKOFF_SECONDS caps how long any single wait
# can be (set to "none" to trust the server's own suggested delay uncapped).
RATE_LIMIT_MAX_ATTEMPTS=2
RATE_LIMIT_MAX_BACKOFF_SECONDS=20

# Optional — trace logs (.jsonl) and screenshots (.png) in LOG_DIR older than this many days are
# deleted at startup. Screenshots are the highest-risk artifact here (full-frame captures of the
# screen at a point in time). Set to 0 or a negative number to disable pruning entirely.
LOG_RETENTION_DAYS=14

LOG_DIR=./logs

# Optional — only set this if `python -m src.doctor` reports Tesseract is installed but not
# found on PATH. Point it at the full path to tesseract.exe (installed via
# https://github.com/UB-Mannheim/tesseract/wiki). Leave blank to rely on PATH.
# Typical default install location:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional — only needed once Langfuse observability is wired in (docs/CODE_LOGIC.md §14)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
